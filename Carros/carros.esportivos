class Ferrari488GTB:
    def __init__(self, cor="vermelho"):
        self.nome = "Ferrari 488 GTB"
        self.motor = "V8 Biturbo"
        self.potencia_hp = 670
        self.torque_nm = 760
        self.cor = cor

    def acelerar(self):
        return f"A {self.nome} {self.cor} está acelerando com seus {self.potencia_hp} hp!"

    def detalhes(self):
        return f"Detalhes da {self.nome}:\nMotor: {self.motor}\nPotência: {self.potencia_hp} hp\nTorque: {self.torque_nm} Nm\nCor: {self.cor}"